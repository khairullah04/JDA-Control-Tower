rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who may use the JDA Control Tower: signed in, and on the access list. The list is ALLOWED_EMAILS in
    // server/.env; the server copies it to access/allowlist at start-up, and only the server can
    // write it. Signing in alone gives nothing: without the list document, everyone is refused.
    function onAccessList() {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/access/allowlist).data.emails;
    }

    // People on the list read and write the tracker's JDAs, projects and activity log directly.
    // Closed to every browser, whoever is signed in:
    //   finance...  invoices, sanctioned amounts and their audit log
    //   access      the access list itself
    //   jdaReports  the portal's report documents (their own rule is below)
    //   site        the text of the two landing pages, saved by the server from edit mode
    // Only the server touches those, with its service-account key, which these rules do not apply to.
    // That is what makes the sign-in, the validation and the audit log binding.
    match /{collection}/{document=**} {
      allow read, write: if onAccessList()
        && !collection.matches('finance.*') && !(collection in ['access', 'jdaReports', 'site']);
    }

    // The JDA report documents (JDA 1 and 2; JDA 3's is in its own project) are private: only people
    // signed in and on the access list read them, and no browser writes them. Saves go through the
    // server (POST /api/portal/save), which keeps the last 20 versions in jdaReports/<jda>/versions.
    // The public Info pages never read these: the server gives them only what may be shown.
    match /jdaReports/{doc} {
      allow read: if onAccessList();
      allow write: if false;
    }
  }
}
