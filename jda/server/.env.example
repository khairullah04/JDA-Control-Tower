ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
FIREBASE_API_KEY=same apiKey value as in web/js/config/firebase-config.js
REQUIRE_AUTH=true
# Who may sign in to the Invoice Tracker: comma-separated email addresses (a username "aina" is aina@jda.app).
# There is no sign-up: create each account in the Firebase console, then add it here and restart.
ALLOWED_EMAILS=
PORT=8080
# Comma-separated: the Invoice Tracker's origin and the portal's
ALLOWED_ORIGIN=http://localhost:8080,http://localhost:8081
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
DRIVE_ROOT_FOLDER_ID=the Drive folder that is the shared invoice inbox
# JDA Programme Portal - Drive sync (see portal/README.md, "Updating from Google Drive")
# Optional: leave out if the JDA folders are in a "JDA Portal" folder inside the invoice Drive folder
# PORTAL_DRIVE_ROOT_FOLDER_ID=the Drive folder that holds the JDA 1, JDA 2 ... folders
# Passkeys: copy portal-passkeys.example.json to portal-passkeys.json (not in git) and set your own, 8+ characters each.
# One per JDA, and "admin" for the Invoice Tracker. The server will not start on short or example values.
# JDA 3's report lives in its own Firebase project; saving it needs that project's service-account key:
# JDA3_GOOGLE_APPLICATION_CREDENTIALS=./service-account-jda3.json
# Invoices and payments (CJI3 register, Payment Tables): saved in Firestore when the service-account key above
# belongs to the Firebase project, otherwise in server/.finance-data.json. Set this to force one: firestore | file
# FINANCE_STORE=firestore
# Only needed if the key's own project is not the Firebase project
# FIREBASE_PROJECT_ID=your-firebase-project-id
