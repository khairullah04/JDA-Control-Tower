rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who may use the JDA Control Tower: signed in with a verified @petronas.com address (the same rule
    // as the server's, server/auth.js SIGNUP_DOMAIN), or on the access list of exceptions. That list is
    // ALLOWED_EMAILS; the server copies it to access/allowlist at start-up, and only the server can
    // write it. An address whose verification link has not been clicked gets nothing.
    function onAccessList() {
      return request.auth != null && (
        (request.auth.token.email_verified == true && request.auth.token.email.lower().matches('^[^@]+@petronas[.]com$'))
        || request.auth.token.email in get(/databases/$(database)/documents/access/allowlist).data.emails);
    }

    // Closed by default: a collection not named below is refused to every browser, whoever is signed in.
    // So invoices and sanctioned amounts (finance...), their stage history, the CJI3 payment lines and
    // uploads (cji3Lines, cji3Imports), the access list and the landing pages' text (site) are written
    // only by the server, with its service-account key, which these rules do not apply to. That is what
    // makes the sign-in, the validation and the audit log binding. A new collection stays closed until
    // it is added here on purpose (server/firestore-rules.test.mjs checks this list).

    // The Invoice Tracker's JDAs and projects, and the marker of their first-time set-up.
    match /jdas/{doc} { allow read, write: if onAccessList(); }
    match /projects/{doc} { allow read, write: if onAccessList(); }
    match /meta/{doc} { allow read, write: if onAccessList(); }
    // The tracker's change log: read, and added to; a line is never changed or removed.
    match /activity/{doc} { allow read, create: if onAccessList(); }
    // The invoice Drive sync (run in the browser): which Drive files it has read. Added to, never changed.
    match /processedFiles/{doc} { allow read, create: if onAccessList(); }
    // The old tracker's invoices and WBS items: read once, to bring them into the register.
    match /invoices/{doc} { allow read: if onAccessList(); }
    match /scope/{doc} { allow read: if onAccessList(); }

    // The JDA report documents (JDA 1 and 2; JDA 3's is in its own project) are private: only people
    // signed in and on the access list read them, and no browser writes them. Saves go through the
    // server (POST /api/portal/save), which keeps the last 20 versions in jdaReports/<jda>/versions.
    // The public Info pages never read these: the server gives them only what may be shown.
    match /jdaReports/{doc} {
      allow read: if onAccessList();
      allow write: if false;
    }
  }
}
