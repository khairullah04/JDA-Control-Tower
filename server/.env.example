ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
FIREBASE_API_KEY=same apiKey value as in web/shared/config/firebase-config.js
# true: every page under /control-tower and every private API needs a sign-in. false is only for trying things on
# your own computer (it opens everything), and the server refuses it when NODE_ENV=production.
REQUIRE_AUTH=true
# Anyone with a verified @petronas.com address signs up on /login by themselves. This list is only for
# exceptions outside that domain (comma-separated; a username "aina" is aina@jda.app). It may be empty.
ALLOWED_EMAILS=
# Who may email invoices from the Microsoft List to the Project Lead (comma-separated emails). Left empty,
# anyone signed in may. Approval itself is by email, and a CJI3 payment line marks an invoice Paid.
ROLE_PM=
# The Microsoft List of invoices before approval, read through Microsoft Graph. Optional: without these the
# Invoice Tracker imports an export (.xlsx or .csv) of the List instead. Needs an app registration in the
# company tenant with Sites.Read.All (admin consent). MS_MAIL_SENDER (and Mail.ReadWrite) also lets it make
# Outlook drafts; without it the email is a .eml file that opens in Outlook. Never commit the real values.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_LIST_ID=
MS_MAIL_SENDER=
# Without an app registration (no IT setup): the List's link (as it opens in the browser), used when nobody has pasted one
# on the page. People sign in to Microsoft themselves from the page (a device code).
MS_LIST_URL=
# Signs the session cookie. Any 32+ random characters. Left out, a restart signs everyone out.
# SESSION_SECRET=
PORT=8080
# Only matters when a site is served from a different address than this server. The server serves both
# sites itself, so this is its own address. Several addresses may be listed, comma-separated.
ALLOWED_ORIGIN=http://localhost:8080
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Where no key file can be placed (Vercel): the key's contents instead (the JSON, or the JSON in base64).
# FIREBASE_SERVICE_ACCOUNT=
DRIVE_ROOT_FOLDER_ID=the Drive folder that is the shared invoice inbox
# JDA Control Tower - JDA report Drive sync (see docs/control-tower.md, "Updating from Google Drive")
# Optional: leave out if the JDA folders are in a "JDA Portal" folder inside the invoice Drive folder
# PORTAL_DRIVE_ROOT_FOLDER_ID=the Drive folder that holds the JDA 1, JDA 2 ... folders
# JDA 3's report lives in its own Firebase project; saving it needs that project's service-account key:
# JDA3_GOOGLE_APPLICATION_CREDENTIALS=./service-account-jda3.json
# Invoices and payments (CJI3 register, Payment Tables): saved in Firestore when the service-account key above
# belongs to the Firebase project, otherwise in server/.finance-data.json. Set this to force one: firestore | file
# FINANCE_STORE=firestore
# On the real server set both of these: with NODE_ENV=production the server refuses to start without FINANCE_STORE.
# NODE_ENV=production
# Only needed if the key's own project is not the Firebase project
# FIREBASE_PROJECT_ID=your-firebase-project-id
