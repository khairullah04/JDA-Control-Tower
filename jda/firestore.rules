rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who may use the Invoice Tracker: signed in, and on the access list. The list is ALLOWED_EMAILS in
    // server/.env; the server copies it to access/allowlist at start-up, and only the server can
    // write it. Signing in alone gives nothing: without the list document, everyone is refused.
    function onAccessList() {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/access/allowlist).data.emails;
    }

    // People on the list read and write the tracker's JDAs, projects and activity log directly.
    // Closed to every browser, whoever is signed in:
    //   finance...  invoices, sanctioned amounts and their audit log
    //   access      the access list itself
    //   jdaReports  the portal's report documents (their own rule is below)
    // Only the server touches those, with its service-account key, which these rules do not apply to.
    // That is what makes the passkeys, the validation and the audit log binding.
    match /{collection}/{document=**} {
      allow read, write: if onAccessList()
        && !collection.matches('finance.*') && collection != 'access' && collection != 'jdaReports';
    }

    // The portal's report pages for JDA 1 and 2 have no sign-in: anyone may read them, nobody may
    // write them from a browser. Saves go through the server (POST /api/portal/save), behind the
    // JDA's passkey, which also keeps the last 20 versions in jdaReports/<jda>/versions.
    match /jdaReports/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
